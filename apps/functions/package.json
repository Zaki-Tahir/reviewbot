{
  "name": "@reviewbot/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "dev": "tsx watch --env-file=.env src/local/server.ts",
    "review": "tsx --env-file=.env src/local/review-pr.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "jose": "^6.2.16",
    "openai": "^7.53.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  }
}
