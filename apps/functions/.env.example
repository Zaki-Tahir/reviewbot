# Local development. In AWS these come from Secrets Manager (see infra/terraform).

# Set to true to work on the dashboard without a GitHub App (fake sign-in and demo data)
LOCAL_DEMO=false

# GitHub App (Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents on one line with \n for newlines
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# openssl rand -base64 32
SESSION_SECRET=
DASHBOARD_URL=http://localhost:5173

# Leave empty for an in-memory store, or use DynamoDB Local from docker compose
DYNAMODB_ENDPOINT=http://localhost:8000
